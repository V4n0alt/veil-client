{
  "name": "veil-ui-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "check": "tsc --noEmit",
    "test": "node scripts/test-ui.mjs",
    "format": "prettier --write src scripts package.json tsconfig.json index.html",
    "format:check": "prettier --check src scripts package.json tsconfig.json index.html"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.6",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
